#!/bin/bash

# UCAS-OS Configuration Script
# This script detects the platform and generates platform-specific configuration

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "========================================="
echo "  UCAS-OS Configuration Script"
echo "========================================="
echo ""

# Detect platform
PLATFORM=$(uname -s)
echo "Detected platform: $PLATFORM"

# Configuration file to generate
CONFIG_FILE="config.mk"

# Default values
CROSS_PREFIX="riscv64-unknown-linux-gnu-"
DIR_OSLAB="$HOME/OSLab-RISC-V"
DIR_QEMU="$DIR_OSLAB/qemu"
DISK="/dev/sdb"
TTYUSB1="/dev/ttyUSB1"

# Platform-specific configurations
case "$PLATFORM" in
    Darwin)
        echo -e "${GREEN}Configuring for macOS...${NC}"
        
        # Check for Homebrew RISC-V toolchain
        if command -v riscv64-unknown-elf-gcc &> /dev/null; then
            CROSS_PREFIX="riscv64-unknown-elf-"
            echo -e "${GREEN}✓ Found riscv64-unknown-elf toolchain${NC}"
        elif command -v riscv64-elf-gcc &> /dev/null; then
            CROSS_PREFIX="riscv64-elf-"
            echo -e "${GREEN}✓ Found riscv64-elf toolchain${NC}"
        elif command -v riscv64-unknown-linux-gnu-gcc &> /dev/null; then
            CROSS_PREFIX="riscv64-unknown-linux-gnu-"
            echo -e "${GREEN}✓ Found riscv64-unknown-linux-gnu toolchain${NC}"
        else
            echo -e "${YELLOW}⚠ RISC-V toolchain not found${NC}"
            echo "  Please install via: brew tap riscv/riscv"
            echo "                      brew install riscv-tools"
            CROSS_PREFIX="riscv64-unknown-elf-"
        fi
        
        # Check for QEMU
        if command -v qemu-system-riscv64 &> /dev/null; then
            QEMU_BIN=$(which qemu-system-riscv64)
            DIR_QEMU=$(dirname "$QEMU_BIN")
            echo -e "${GREEN}✓ Found QEMU at: $QEMU_BIN${NC}"
        else
            echo -e "${YELLOW}⚠ QEMU not found${NC}"
            echo "  Please install via: brew install qemu"
            DIR_QEMU="/usr/local/bin"
        fi
        
        # macOS doesn't typically use /dev/sdb
        DISK="/dev/disk6"
        TTYUSB1="/dev/cu.usbserial"
        
        # macOS uses gsed, ggrep if installed via brew
        if command -v gsed &> /dev/null; then
            echo -e "${GREEN}✓ Found GNU sed (gsed)${NC}"
        fi

        DIR_OSLAB="../toolkit"
        
        ;;
        
    Linux)
        echo -e "${GREEN}Configuring for Linux...${NC}"
        
        # Check for RISC-V toolchain
        if command -v riscv64-unknown-linux-gnu-gcc &> /dev/null; then
            CROSS_PREFIX="riscv64-unknown-linux-gnu-"
            echo -e "${GREEN}✓ Found RISC-V toolchain${NC}"
        else
            echo -e "${YELLOW}⚠ RISC-V toolchain not found${NC}"
            echo "  Please install the RISC-V toolchain"
        fi
        
        # Check for QEMU
        if command -v $DIR_QEMU/riscv64-softmmu/qemu-system-riscv64 &> /dev/null; then
            echo -e "${GREEN}✓ Found QEMU${NC}"
        else
            echo -e "${YELLOW}⚠ QEMU not found${NC}"
        fi
        
        ;;
        
    *)
        echo -e "${RED}Unsupported platform: $PLATFORM${NC}"
        exit 1
        ;;
esac

# Allow user to override paths
echo ""
echo "Current configuration:"
echo "  CROSS_PREFIX = $CROSS_PREFIX"
echo "  DIR_OSLAB    = $DIR_OSLAB"
echo "  DIR_QEMU     = $DIR_QEMU"
echo "  DISK         = $DISK"
echo ""

read -p "Do you want to customize these paths? (y/N) " -n 1 -r
echo ""
if [[ $REPLY =~ ^[Yy]$ ]]; then
    read -p "CROSS_PREFIX [$CROSS_PREFIX]: " input
    CROSS_PREFIX=${input:-$CROSS_PREFIX}
    
    read -p "DIR_OSLAB [$DIR_OSLAB]: " input
    DIR_OSLAB=${input:-$DIR_OSLAB}
    
    read -p "DIR_QEMU [$DIR_QEMU]: " input
    DIR_QEMU=${input:-$DIR_QEMU}
    
    read -p "DISK [$DISK]: " input
    DISK=${input:-$DISK}
fi

# Generate config.mk
echo "Generating $CONFIG_FILE..."
cat > "$CONFIG_FILE" << EOF
# Auto-generated configuration file
# Platform: $PLATFORM
# Generated: $(date)

# -----------------------------------------------------------------------
# Platform-specific Configuration
# -----------------------------------------------------------------------

PLATFORM        = $PLATFORM
CROSS_PREFIX    = $CROSS_PREFIX
DIR_OSLAB       = $DIR_OSLAB
DIR_QEMU        = $DIR_QEMU
DISK            = $DISK
TTYUSB1         = $TTYUSB1

# Derived paths
DIR_UBOOT       = \$(DIR_OSLAB)/u-boot

EOF

# Platform-specific tool settings
if [ "$PLATFORM" = "Darwin" ]; then
    cat >> "$CONFIG_FILE" << EOF
# macOS-specific settings
QEMU            = qemu-system-riscv64
MINICOM         = minicom

# Use GNU tools if available
SED             = \$(shell command -v gsed 2>/dev/null || echo sed)
GREP            = \$(shell command -v ggrep 2>/dev/null || echo grep)

EOF
else
    cat >> "$CONFIG_FILE" << EOF
# Linux-specific settings
QEMU            = \$(DIR_QEMU)/riscv64-softmmu/qemu-system-riscv64
MINICOM         = minicom

EOF
fi

echo -e "${GREEN}✓ Configuration file generated: $CONFIG_FILE${NC}"
echo ""
echo "You can now build the project with 'make'"
echo ""

# Verify tools
echo "Verifying required tools..."
MISSING_TOOLS=0

check_tool() {
    if command -v $1 &> /dev/null; then
        echo -e "${GREEN}✓${NC} $1"
    else
        echo -e "${RED}✗${NC} $1 (missing)"
        MISSING_TOOLS=$((MISSING_TOOLS + 1))
    fi
}

check_tool "${CROSS_PREFIX}gcc"
check_tool "${CROSS_PREFIX}objdump"
check_tool "${CROSS_PREFIX}gdb"
check_tool "qemu-system-riscv64"

echo ""
if [ $MISSING_TOOLS -eq 0 ]; then
    echo -e "${GREEN}All required tools are available!${NC}"
else
    echo -e "${YELLOW}Warning: $MISSING_TOOLS tool(s) missing${NC}"
    echo "The build may fail without these tools."
fi

echo ""
echo "========================================="
echo "  Configuration complete!"
echo "========================================="
